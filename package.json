    "ui",
    "core",
    "adapters",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "native/assets",
    "native/bin",
    "standalone",
    "scripts",
    "README.md",
    "dist/ui",
    "dist/types",
    "vite.library.config.ts",
    "tsconfig.json",
    "tsconfig.build.json",
    "dist/core",
    "docs",
    "fixtures/*.xlsx",
    "fixtures/build-corpus.py",
    "fixtures/expectations.json",
    "fixtures/budgets*.json",
    "fixtures/spreadsheet-model-before.ts",
    "fixtures/spreadsheet-adapter-before.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "test": "node tests/native-client-protocol.mjs && node --import ./scripts/ts-resolve-register.mjs  --test tests/workbook-indexed.mjs tests/native-diagnostics.mjs tests/indexed-cache.mjs tests/indexed-checkpoint.mjs tests/workbook-style-index.mjs && node --import ./scripts/ts-resolve-register.mjs --test tests/range-diagnostics.mjs && node --import ./scripts/ts-resolve-register.mjs tests/sheet-model.mjs && node --import ./scripts/ts-resolve-register.mjs tests/sheet-history.mjs && node tests/csv-sparse-save.mjs && node --test tests/csv-file.mjs tests/indexed-csv-session.mjs tests/csv-owner-worker.mjs && npm run test:document && npm run test:features && npm run test:compat && node tests/package-roundtrip.mjs && npm run test:cleanup",
    "pretest": "npm run build",
    "build:ui": "vite build --config vite.library.config.ts && node scripts/build-types.mjs",
    "build": "npm run build:native && npm run build:ui",
    "prepack": "npm run build",
    "test:document": "node --test --test-concurrency=1 tests/document-session.mjs tests/new-workbook.mjs tests/worker-lifecycle.mjs tests/document-save-crash.mjs tests/operation-gate.mjs tests/filter-values-transport.mjs && node --import ./scripts/ts-resolve-register.mjs --test --test-concurrency=1 tests/large-paste.mjs tests/indexed-import.mjs tests/indexed-owner-import.mjs tests/staged-paste-oracle.mjs tests/document-import.mjs tests/document-import-crash.mjs tests/document-redo-retention.mjs tests/document-objects.mjs tests/worker-reaping-proof.mjs tests/object-transport.mjs && node --test tests/recent-files.mjs tests/standalone-bridge.mjs tests/print-document.mjs tests/saved-package-oracle.mjs && npm run test:search && npm run test:delimited-import && npm run test:tabs",
    "test:reference": "node scripts/test/reference-corpus.mjs",
    "test:search": "node --import ./scripts/ts-resolve-register.mjs --test tests/search-pages.mjs",
    "test:features": "node --import ./scripts/ts-resolve-register.mjs --test --test-concurrency=1 tests/workbook-real-protected.mjs tests/package-capabilities.mjs tests/readonly-export.mjs tests/workbook-name-update.mjs tests/name-update-admission.mjs tests/name-dependency-admission.mjs tests/workbook-spills.mjs tests/workbook-spill-boundaries.mjs tests/workbook-spill-consumers.mjs tests/workbook-spill-print.mjs tests/workbook-spill-metadata.mjs tests/spill-metadata-oracle.mjs tests/workbook-objects.mjs tests/managed-object-extensions.mjs tests/indexed-owner-objects.mjs tests/native-managed-chart-cache.mjs tests/workbook-print.mjs tests/print-conditional.mjs tests/document-print.mjs tests/kept-recovery.mjs tests/rules-model.mjs tests/workbook-rules.mjs tests/document-rules.mjs tests/workbook-table-edits.mjs tests/workbook-scalar-arrays.mjs tests/workbook-month-dates.mjs tests/workbook-pivots.mjs tests/document-pivots.mjs && node tests/workbook-objects-ui.mjs && node tests/workbook-print-ui.mjs && node tests/workbook-rules-ui.mjs",
    "format": "npx --yes prettier@3.6.2 --write \"core/**/*.{mjs,ts,mts}\" \"ui/**/*.{ts,tsx,css}\" \"adapters/**/*.{mjs,ts}\" \"standalone/**/*.{mjs,cjs,ts,tsx}\" \"tests/**/*.{mjs,ts,tsx}\" \"scripts/**/*.{mjs,ts,cjs}\" \"*.css\" && cargo fmt --manifest-path native/Cargo.toml",
    "test:format": "node scripts/test/line-length.mjs && node scripts/test/documentation-contract.mjs",
    "test:ordinary": "node --import ./scripts/ts-resolve-register.mjs --test tests/ordinary-sheets.mjs && node --import ./scripts/ts-resolve-register.mjs --test tests/refusal-codes.mjs && node --import ./scripts/ts-resolve-register.mjs --test tests/preserved-layout.mjs && node --import ./scripts/ts-resolve-register.mjs --test tests/calculator-routes.mjs",
    "test:compat": "node --test --test-concurrency=1 tests/compat-*.test.mjs",
    "benchmark:transfer": "node scripts/bench/workbook-transfer-rss.mjs",
    "benchmark:model": "node --import ./scripts/ts-resolve-register.mjs scripts/bench/sheet-model.mjs",
    "test:browser": "node scripts/test/xlsx-sheet-grid.mjs && node scripts/test/xlsx-indexed-grid.mjs && node scripts/test/csv-grid.mjs",
    "test:preservation": "node scripts/test/xlsx-preservation-matrix.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "test:cleanup": "node tests/clean-artifacts.mjs",
    "test:delimited-import": "node --import ./scripts/ts-resolve-register.mjs --test --test-concurrency=1 tests/delimited-import.mjs tests/delimited-file-import.mjs",
    "test:objects:extensions": "node --import ./scripts/ts-resolve-register.mjs --test --test-concurrency=1 tests/managed-object-extensions.mjs && node --test tests/workbook-objects-ui.mjs",
    "test:tabs": "node --test tests/workbook-tab-registry.mjs",
    "test:tables": "node --import ./scripts/ts-resolve-register.mjs --test tests/workbook-table-edits.mjs",
    "test:scalar-arrays": "node --test tests/workbook-scalar-arrays.mjs",
    "test:month-dates": "node --test tests/compat-xlsx-month-dates.test.mjs tests/workbook-month-dates.mjs",
    "test:pivots": "node --import ./scripts/ts-resolve-register.mjs --test tests/workbook-pivots.mjs tests/document-pivots.mjs",
    "test:remaining-formats": "node --import ./scripts/ts-resolve-register.mjs --test tests/passive-formats.mjs tests/passive-format-ovba.mjs tests/pure-vba.mjs tests/pure-vba-excel-reference.mjs tests/passive-data-export.mjs tests/xlsb-values-normalize.mjs tests/document-passive-formats.mjs tests/bounded-range-read.mjs",
    "desktop:build": "node desktop/scripts/build-editor.mjs && node desktop/scripts/build.mjs",
    "desktop:package": "node desktop/scripts/package.mjs",
    "gates": "node scripts/gates.mjs",
    "test:all": "node scripts/test/run.mjs",
    "test:alone": "node scripts/test/folder-alone.mjs"
  },
