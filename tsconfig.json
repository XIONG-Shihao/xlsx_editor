{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "core/**/*.ts",
    "adapters/**/*.ts",
    "standalone/**/*.ts",
    "standalone/**/*.tsx"
  ]
}
