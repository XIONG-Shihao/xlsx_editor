          "formula": "B2*C2",
          "calculated": 250
        },
        "Pricing!E2": {
          "formula": "TaxRate",
          "calculated": 0.09
        },
        "Pricing!F2": {
          "formula": "D2*(1+E2)",
          "calculated": 272.5
        },
        "Pricing!D4": {
          "formula": "SUM(D2:D3)",
          "calculated": 330
        },
        "Pricing!F4": {
          "formula": "SUM(F2:F3)",
          "calculated": 359.7
        },
        "Pricing!D5": {
          "formula": "SUM(PricingItems[Subtotal])",
          "calculated": 330
        }
      },
      "scenario": {
        "name": "person quantity then agent unit price",
        "edits": [
          {
            "sheet": "Pricing",
            "cell": "B2",
            "value": 3
          },
          {
            "sheet": "Pricing",
            "cell": "C2",
            "value": 150
          }
