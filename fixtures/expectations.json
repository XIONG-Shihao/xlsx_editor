        "expected": {
          "Pricing!D2": 450,
          "Pricing!F2": 490.5,
          "Pricing!D4": 530,
          "Pricing!F4": 577.7,
          "Pricing!D5": 530
        }
      },
      "preservation": {
        "allowedChanged": [
          "xl/worksheets/sheet1.xml",
          "xl/workbook.xml"
        ],
        "requiredByteIdentical": [
          "xl/tables/table1.xml",
          "xl/worksheets/sheet2.xml",
          "xl/styles.xml"
        ]
      },
      "baselinePolicy": {
        "desktopLiteralEdit": "supported",
        "mcpExactEdit": "refused: table dependency profile",
        "mcpCommonEdit": "requires optional Aspose before migration"
